                "exceptions": true
            }
        },
        {
            "name": "Debug VST3 Validator",
            "type": "cppdbg",
            "request": "launch",
            "program": "${env:JUCE_PATH}/extras/AudioPluginHost/Builds/MacOSX/build/Debug/AudioPluginHost.app/Contents/MacOS/AudioPluginHost",
            "args": [
                "${workspaceFolder}/build-debug/Spectrogram_artefacts/Debug/VST3/Spectrogram.vst3"
            ],
            "stopAtEntry": false,
